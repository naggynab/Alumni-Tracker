# Copy to .env and adjust for your environment.

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Database. Defaults to a local SQLite file when unset.
# For Postgres (matching the production data sources):
# DATABASE_URL=postgres://user:password@localhost:5432/alumni

# Email delivery. Set EMAIL_PROVIDER to `resend` or `smtp`; leave it empty for
# console email output in local development.
# For Google Workspace/Gmail SMTP, create a Google App Password (not your normal
# account password), set it below, then change EMAIL_ENABLED to True.
# ACCOUNT_EMAIL_VERIFICATION=mandatory   # or "optional" / "none"
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Google sign-in (create OAuth credentials in Google Cloud Console).
# Authorized redirect URI (production):
# https://alumni-tracker.itprojects.pcampus.edu.np/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Department officer access. By default, no email domain is trusted.
# Add exact individual emails to the allowlist, or use the Department Staff
# group / `grant_department_access` management command. Setting domains here
# trusts every authenticated user under those domains; enable deliberately.
DEPARTMENT_EMAILS=
DEPARTMENT_EMAIL_DOMAINS=
DEPARTMENT_GROUP_NAME=Department Staff
DEPARTMENT_DATA_EDITOR_GROUP=Alumni Data Editors
DEPARTMENT_ADMIN_GROUP=Alumni Administrators
