# Copy to .env and adjust for your environment.

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Database. Defaults to a local SQLite file when unset.
# For Postgres (matching the production data sources):
# DATABASE_URL=postgres://user:password@localhost:5432/alumni

# Email delivery. The Resend API is selected whenever RESEND_API_KEY is set.
# For local development, leave all email settings empty to print messages to the console.
# For Google Workspace/Gmail SMTP, create a Google App Password (not your normal
# account password), set it below, then change EMAIL_ENABLED to True.
# ACCOUNT_EMAIL_VERIFICATION=mandatory   # or "optional" / "none"
RESEND_API_KEY=
EMAIL_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Google sign-in (create OAuth credentials in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
